name: Patchbot daily reapply

on:
  schedule:
    - cron: "17 9 * * *"
  workflow_dispatch:

permissions:
  contents: write
  pull-requests: write

jobs:
  reapply:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
        with:
          fetch-depth: 0

      - uses: actions/setup-node@v4
        with:
          node-version: 24

      - name: Reapply fork patches to upstream main
        env:
          PATCHBOT_BRANCH: patchbot/daily
        run: |
          git fetch origin main
          git switch --create "$PATCHBOT_BRANCH" origin/main
          node --experimental-strip-types tools/patchbot/patchbot.ts apply --all

      - name: Open or update patchbot pull request
        env:
          GH_TOKEN: ${{ github.token }}
          PATCHBOT_BRANCH: patchbot/daily
        run: |
          git config user.name "github-actions[bot]"
          git config user.email "41898282+github-actions[bot]@users.noreply.github.com"
          git add -A
          git diff --cached --quiet && echo "No patch changes" && exit 0
          git commit -m "chore: reapply fork patches"
          git push --force origin "HEAD:$PATCHBOT_BRANCH"
          gh pr create --base main --head "$PATCHBOT_BRANCH" \
            --title "chore: reapply fork patches" \
            --body "Daily Patchbot reapplication. Review the generated diff and run the relevant checks." \
            || gh pr edit "$PATCHBOT_BRANCH" --body "Daily Patchbot reapplication. Review the generated diff and run the relevant checks."
